{
  "name": "signalbox",
  "version": "0.1.0",
  "private": true,
  "description": "A production Cosmo Router and federated GraphQL subgraphs on AWS Fargate.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "subgraphs/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:deps": "depcruise \"{packages,subgraphs,apps,infra,scripts}/**/*.{ts,tsx}\" --config .dependency-cruiser.cjs",
    "check:dupes": "jscpd --config .jscpd.json",
    "check:unused": "knip",
    "check:hygiene": "node scripts/repo-check.ts hygiene",
    "check:traceability": "node scripts/repo-check.ts traceability",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:deps && npm run check:dupes && npm run check:unused && npm run check:hygiene && npm run check:traceability && npm run test:coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@signalbox/repo-checks": "*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
